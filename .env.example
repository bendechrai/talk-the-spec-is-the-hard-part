# Nothing here is required. The deck, the fallback builds, the live builds
# and the live critic all run on your Claude Code login (claude auth status
# must say loggedIn: true). No API key is used anywhere.
#
# Optional: where the claude binary lives, if it is not on the PATH of the
# shell that starts the deck (for example when launched from an app).
# CLAUDE_BIN=/Users/you/.local/bin/claude

# Model for the live critic (press a). sonnet starts writing within seconds;
# opus digs deeper but thinks for a minute first. Default: sonnet.
# CRITIC_MODEL=sonnet

# Shown above the title on the first slide. Leave unset for no event line.
NEXT_PUBLIC_EVENT=KCDC 2026
